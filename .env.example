# ── IUB Event Management — Firebase web config ────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and paste the values from your
# Firebase console: Project settings → General → Your apps → Web app →
# "SDK setup and configuration" → Config.
#
# `.env` is gitignored. These VITE_* values are embedded in the client bundle
# (they are NOT secrets — Firebase security is enforced by Auth + Firestore
# rules, not by hiding these keys). Restrict them via API key restrictions in
# the Google Cloud console for production.
#
# If these are left blank the app runs in local DEMO MODE (no persistence).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
